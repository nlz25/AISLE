{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aisle-contribute",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "aisle.science/api/contribute/*", "zone_name": "aisle.science" }],
  "vars": {
    "SITE_ORIGIN": "https://aisle.science",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "",
    "MAIL_FROM": "",
    "TURNSTILE_SITE_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aisle-contribute",
      "database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PACKAGES", "bucket_name": "aisle-contribute-private" }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": false }
}
